{
  "sourceLanguage": "en",
  "strings": {
    "%@: code %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : code %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Code %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: código %2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: codice %2$@"
          }
        }
      }
    },
    "A code you pinned in Verrou.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un code épinglé dans Verrou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein in Verrou angehefteter Code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un código fijado en Verrou."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un codice fissato in Verrou."
          }
        }
      }
    },
    "Code": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Code"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Code"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Codice"
          }
        }
      }
    },
    "One-time code": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Code à usage unique"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmalcode"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código de un solo uso"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Codice monouso"
          }
        }
      }
    },
    "Open Verrou if the code doesn't show.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Verrou si le code ne s'affiche pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Verrou, falls der Code nicht erscheint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Verrou si el código no aparece."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Verrou se il codice non compare."
          }
        }
      }
    },
    "Pin a code in Verrou": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Épinglez un code dans Verrou"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hefte einen Code in Verrou an"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija un código en Verrou"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fissa un codice in Verrou"
          }
        }
      }
    },
    "On your iPhone, open an item and turn on Show in widgets and on Apple Watch.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur votre iPhone, ouvrez un élément et activez « Afficher dans les widgets et sur l'Apple Watch »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne auf deinem iPhone einen Eintrag und aktiviere „In Widgets und auf der Apple Watch zeigen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu iPhone, abre un elemento y activa «Mostrar en widgets y en el Apple Watch»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su iPhone, apri un elemento e attiva «Mostra nei widget e su Apple Watch»."
          }
        }
      }
    },
    "Shows a one-time code pinned in Verrou.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche un code à usage unique épinglé dans Verrou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt einen in Verrou angehefteten Einmalcode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un código de un solo uso fijado en Verrou."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un codice monouso fissato in Verrou."
          }
        }
      }
    },
    "Unlock your watch": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez votre montre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperre deine Uhr"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea tu reloj"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca il tuo orologio"
          }
        }
      }
    },
    "Updating…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise à jour…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird aktualisiert…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizando…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiornamento…"
          }
        }
      }
    },
    "Your pinned codes show after the first unlock.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos codes épinglés s'affichent après le premier déverrouillage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine angehefteten Codes erscheinen nach dem ersten Entsperren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus códigos fijados aparecen tras el primer desbloqueo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi codici fissati compaiono dopo il primo sblocco."
          }
        }
      }
    }
  },
  "version": "1.0"
}
