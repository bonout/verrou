    "Search your vault, generate a password or scan a two-factor QR code.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherchez dans votre coffre, générez un mot de passe ou scannez un QR code de double authentification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsuche deinen Tresor, erzeuge ein Passwort oder scanne einen QR-Code für die Zwei-Faktor-Authentifizierung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca en tu bóveda, genera una contraseña o escanea un código QR de doble factor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca nella cassaforte, genera una password o scansiona un codice QR a due fattori."
          }
        }
      }
    },
    "Shows a one-time code pinned in Verrou.": {
      "localizations": {
        "fr": {
          "stringUnit": {
