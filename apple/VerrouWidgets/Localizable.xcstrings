    "Open Verrou if the code doesn't show.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Verrou si le code ne s'affiche pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Verrou, falls der Code nicht erscheint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Verrou si el código no aparece."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Verrou se il codice non compare."
          }
        }
      }
    },
    "Opens Verrou on the search, with the text if you give one.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Verrou sur la recherche, avec le texte si vous en donnez un."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Verrou bei der Suche, mit dem Text, falls du einen angibst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Verrou en la búsqueda, con el texto si das uno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre Verrou sulla ricerca, con il testo se ne indichi uno."
          }
        }
      }
    },
    "Opens Verrou on the search.": {
      "localizations": {
        "fr": {
