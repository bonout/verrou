    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera scans the QR code of a one-time code (two-factor authentication). No image is saved."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caméra sert à scanner le QR code d'un code à usage unique (double authentification). Aucune image n'est enregistrée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera scannt den QR-Code eines Einmalcodes (Zwei-Faktor-Authentifizierung). Es wird kein Bild gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara escanea el código QR de un código de un solo uso (autenticación de doble factor). No se guarda ninguna imagen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera scansiona il codice QR di un codice monouso (autenticazione a due fattori). Nessuna immagine viene salvata."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID unlocks your vault and confirms access to protected items."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID déverrouille votre coffre et confirme l'accès aux éléments protégés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID entsperrt deinen Tresor, um Logins, Codes und Passkeys auszufüllen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID desbloquea tu bóveda para rellenar inicios de sesión, códigos y llaves de acceso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID sblocca la tua cassaforte per compilare login, codici e passkey."
          }
        }
      }
    },
    "NSHumanReadableCopyright": {
