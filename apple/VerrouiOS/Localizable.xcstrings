          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Bitwarden“ ist eine Marke von Bitwarden, Inc. Verrou ist weder mit Bitwarden verbunden noch von Bitwarden unterstützt."
          }
        },
        "es": {
