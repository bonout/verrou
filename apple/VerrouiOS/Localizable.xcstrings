    "Personal copies are created (history, passkeys, codes, fields and attachments included), then the items are permanently deleted %@: their members will no longer see them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des copies personnelles sont créées (historique, passkeys, codes, champs et pièces jointes compris), puis les éléments sont supprimés définitivement %@ : leurs membres ne les verront plus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Persönliche Kopien werden erstellt (inklusive Verlauf, Passkeys, Codes, Felder und Anhänge), dann werden die Einträge %@ endgültig gelöscht: Ihre Mitglieder sehen sie nicht mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se crean copias personales (con historial, llaves de acceso, códigos, campos y archivos adjuntos) y luego los elementos se eliminan definitivamente %@: sus miembros dejarán de verlos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono create copie personali (cronologia, passkey, codici, campi e allegati inclusi), poi gli elementi vengono eliminati definitivamente %@: i loro membri non li vedranno più."
          }
        }
      }
    },
