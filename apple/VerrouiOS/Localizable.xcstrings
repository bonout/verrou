    "1 item will be moved out of the folder, to no folder. The item is not deleted.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 élément sera sorti du dossier, sans dossier. L’élément n’est pas supprimé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Eintrag wird aus dem Ordner herausgenommen und hat dann keinen Ordner. Der Eintrag wird nicht gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 elemento saldrá de la carpeta y quedará sin carpeta. El elemento no se elimina."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1 elemento verrà tolto dalla cartella e resterà senza cartella. L’elemento non viene eliminato."
          }
        }
      }
    },
