    "You are no longer part of this shared vault.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne faites plus partie de ce coffre partagé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du gehörst nicht mehr zu diesem geteilten Tresor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no formas parte de esta bóveda compartida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non fai più parte di questa cassaforte condivisa."
          }
        }
      }
    },
    "You are notified when they have accepted: compare their fingerprint phrase, then confirm them here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes prévenu quand elle a accepté : comparez sa phrase d'empreinte, puis confirmez-la ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst benachrichtigt, wenn die Person angenommen hat: Vergleiche ihre Fingerabdruck-Phrase und bestätige sie dann hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibirás un aviso cuando haya aceptado: compara su frase de huella digital y confírmalo aquí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riceverai una notifica quando avrà accettato: confronta la sua frase impronta, poi confermalo qui."
          }
        }
      }
    },
    "You joined %@. An administrator still has to confirm your account: you will be notified.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez rejoint %@. Un administrateur doit encore confirmer votre compte : vous serez prévenu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist %@ beigetreten. Ein:e Administrator:in muss deinen Account noch bestätigen: Du wirst benachrichtigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te has unido a %@. Un administrador aún tiene que confirmar tu cuenta: recibirás un aviso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti sei unito a %@. Un amministratore deve ancora confermare il tuo account: riceverai una notifica."
          }
        }
      }
    },
    "You left %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez quitté %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %@ verlassen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has abandonado %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai lasciato %@"
          }
        }
      }
    },
    "You must be able to edit the item and see its password": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut pouvoir modifier l'élément et en voir le mot de passe"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst den Eintrag bearbeiten und sein Passwort sehen können"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes poder editar el elemento y ver su contraseña"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Devi poter modificare l'elemento e vederne la password"
          }
        }
      }
    },
    "You now have access to %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez maintenant accès à %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast jetzt Zugriff auf %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora tienes acceso a %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora hai accesso a %@."
          }
        }
      }
    },
    "You will need the master password and the second factor to come back.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faudra le mot de passe principal et le second facteur pour revenir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du benötigst das Master-Passwort und den zweiten Faktor, um zurückzukommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitarás la contraseña maestra y el segundo factor para volver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per tornare serviranno la password principale e il secondo fattore."
          }
        }
      }
    },
    "Your Vaultwarden vault, on your iPhone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre coffre Vaultwarden, sur votre iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Vaultwarden-Tresor auf deinem iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu bóveda de Vaultwarden, en tu iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua cassaforte Vaultwarden, sul tuo iPhone."
          }
        }
      }
    },
    "Your role doesn't allow seeing the members: only the name can be edited here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre rôle ne permet pas de voir les membres : seul le nom se modifie ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Rolle erlaubt es nicht, die Mitglieder zu sehen: Hier kann nur der Name bearbeitet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu rol no permite ver los miembros: aquí solo se puede editar el nombre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo ruolo non consente di vedere i membri: qui si può modificare solo il nome."
          }
        }
      }
    },
    "Your role: %@. The items shared here are encrypted with the organization's key.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre rôle : %@. Les éléments partagés ici sont chiffrés avec la clé de l'organisation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Rolle: %@. Die hier geteilten Einträge sind mit dem Schlüssel der Organisation verschlüsselt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu rol: %@. Los elementos compartidos aquí se cifran con la clave de la organización."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo ruolo: %@. Gli elementi condivisi qui sono cifrati con la chiave dell'organizzazione."
          }
        }
      }
    },
    "Your server's sign-in page opens: hold the YubiKey near the top of the iPhone, or plug it in, then touch it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page de connexion de votre serveur s'ouvre : approchez la YubiKey du haut de l'iPhone, ou branchez-la, puis touchez-la."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldeseite deines Servers öffnet sich: Halte den YubiKey an den oberen Rand des iPhone oder schließe ihn an und berühre ihn dann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abre la página de inicio de sesión de tu servidor: acerca la YubiKey a la parte superior del iPhone, o conéctala, y tócala."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si apre la pagina di accesso del tuo server: avvicina la YubiKey alla parte superiore dell'iPhone, o collegala, poi toccala."
          }
        }
      }
    },
    "access “%@”": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "accéder à « %@ »"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "auf „%@“ zugreifen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "acceder a “%@”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "accedere a “%@”"
          }
        }
      }
    },
