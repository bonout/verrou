    "1. Open **Settings → General → AutoFill & Passwords**.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Ouvrez **Réglages → Général → Remplissage automatique et mots de passe**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Öffne **Einstellungen → Allgemein → Automatisch ausfüllen & Passwörter**."
          }
        },
        "es": {
