    "It is saved in your Vaultwarden vault, in Bitwarden's format: your other devices find it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle est enregistrée dans votre coffre Vaultwarden, au format de Bitwarden : vos autres appareils la retrouvent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wird in deinem Vaultwarden-Tresor im Bitwarden-Format gesichert: Deine anderen Geräte finden ihn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda en tu bóveda de Vaultwarden, en el formato de Bitwarden: tus otros dispositivos lo encuentran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È salvata nella tua cassaforte Vaultwarden, nel formato di Bitwarden: i tuoi altri dispositivi la trovano."
          }
        }
      }
    },
    "It may have been deleted elsewhere.": {
