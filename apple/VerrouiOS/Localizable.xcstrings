        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos sus elementos"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i suoi elementi"
          }
        }
      }
    },
    "All rights, including over the other owners and administrators.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les droits, y compris sur les autres propriétaires et administrateurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Rechte, auch über die anderen Eigentümer:innen und Administrator:innen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los derechos, incluso sobre los demás propietarios y administradores."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i diritti, anche sugli altri proprietari e amministratori."
          }
        }
      }
    },
    "Allow the camera in Settings to scan the Mac's code.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’appareil photo dans Réglages pour scanner le code du Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube die Kamera in den Einstellungen, um den Code des Mac zu scannen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a la cámara en Ajustes para escanear el código del Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l'accesso alla fotocamera in Impostazioni per scansionare il codice del Mac."
          }
        }
      }
    },
    "Allow the camera in Settings to scan, or choose a screenshot of the QR code.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez la caméra dans Réglages pour scanner, ou choisissez une capture d'écran du QR code."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube die Kamera in den Einstellungen, um zu scannen, oder wähle ein Bildschirmfoto des QR-Codes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a la cámara en Ajustes para escanear, o elige una captura de pantalla del código QR."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l'accesso alla fotocamera in Impostazioni per scansionare, oppure scegli uno screenshot del codice QR."
          }
        }
      }
    },
    "An administrator of %@ must confirm you: read them your fingerprint phrase": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un administrateur de %@ doit vous confirmer : lisez-lui votre phrase d'empreinte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein:e Administrator:in von %@ muss dich bestätigen: Lies ihm oder ihr deine Fingerabdruck-Phrase vor"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un administrador de %@ debe confirmarte: léele tu frase de huella digital"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un amministratore di %@ deve confermarti: leggigli la tua frase impronta"
          }
        }
      }
    },
    "An invitation only appears in Verrou once accepted: before that, the server only shows it to the email. On a server without email, the invitation of an existing account is accepted automatically: nothing to paste.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une invitation n'apparaît dans Verrou qu'une fois acceptée : avant, le serveur ne la montre qu'à l'e-mail. Sur un serveur sans e-mail, l'invitation d'un compte existant est acceptée d'office : rien à coller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Einladung erscheint in Verrou erst, wenn sie angenommen wurde: Bis dahin zeigt der Server sie nur der E-Mail-Adresse. Auf einem Server ohne E-Mail wird die Einladung eines bestehenden Accounts automatisch angenommen: Es muss nichts eingefügt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una invitación solo aparece en Verrou una vez aceptada: antes, el servidor solo la muestra en el correo electrónico. En un servidor sin correo electrónico, la invitación de una cuenta existente se acepta automáticamente: no hay nada que pegar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un invito appare in Verrou solo dopo essere stato accettato: prima di allora il server lo mostra solo via email. Su un server senza email, l'invito di un account esistente viene accettato automaticamente: non c'è niente da incollare."
          }
        }
      }
    },
