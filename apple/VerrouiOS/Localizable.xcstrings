    "Its items stay in the organization: the administrators still see them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses éléments restent dans l'organisation : les administrateurs les voient toujours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Einträge bleiben in der Organisation: Die Administrator:innen sehen sie weiterhin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus elementos se quedan en la organización: los administradores siguen viéndolos."
          }
