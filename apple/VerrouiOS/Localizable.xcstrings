          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Abgleich bestimmt die Seiten, auf denen das Login angeboten wird; er wird wie in Bitwarden mit dem Eintrag gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
