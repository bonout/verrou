    "Swipe a collection to the left to edit or delete it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez une collection vers la gauche pour la modifier ou la supprimer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streiche auf einer Sammlung nach links, um sie zu bearbeiten oder zu löschen."
          }
