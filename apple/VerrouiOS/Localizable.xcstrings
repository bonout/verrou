          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 HOTP-Account (zählerbasiert) übersprungen: Nur TOTP-Codes werden unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 cuenta HOTP (basada en contador) omitida: solo se admiten códigos TOTP."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1 account HOTP (basato su contatore) ignorato: sono supportati solo i codici TOTP."
          }
        }
      }
    },
