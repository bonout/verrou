    "%@ unsynced changes will be lost. You will need your master password and your second factor to log in again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ modifications non synchronisées seront perdues. Il faudra votre mot de passe principal et votre second facteur pour vous reconnecter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nicht synchronisierte Änderungen gehen verloren. Du benötigst dein Master-Passwort und deinen zweiten Faktor, um dich erneut anzumelden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perderán %@ cambios no sincronizados. Necesitarás tu contraseña maestra y tu segundo factor para volver a iniciar sesión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ modifiche non sincronizzate andranno perse. Per accedere di nuovo serviranno la password principale e il secondo fattore."
          }
        }
      }
    },
    "%@ wants to %@.": {
      "localizations": {
