    },
    "“%@”\n\nAsk %@ for their account's fingerprint phrase (Verrou: Settings → Account; web vault: Settings → My account). Confirm only if it is identical: the organization's key will be encrypted for this person.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ »\n\nDemandez à %2$@ la phrase d'empreinte de son compte (Verrou : Réglages → Compte ; coffre web : Paramètres → Mon compte). Confirmez seulement si elle est identique : la clé de l'organisation sera chiffrée pour cette personne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“\n\nBitte %@ um die Fingerabdruck-Phrase des Accounts (Verrou: Einstellungen → Account; Web-Tresor: Einstellungen → Mein Konto). Bestätige nur, wenn sie identisch ist: Der Schlüssel der Organisation wird für diese Person verschlüsselt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”\n\nPide a %@ la frase de huella digital de su cuenta (Verrou: Ajustes → Cuenta; bóveda web: Settings → My account). Confirma solo si es idéntica: la clave de la organización se cifrará para esta persona."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”\n\nChiedi a %@ la frase impronta del suo account (Verrou: Impostazioni → Account; cassaforte web: Impostazioni → Il mio account). Conferma solo se è identica: la chiave dell'organizzazione verrà cifrata per questa persona."
          }
        }
      }
    },
    "“%@” already has a one-time code.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » a déjà un code à usage unique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ hat bereits einen Einmalcode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ya tiene un código de un solo uso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ha già un codice monouso."
          }
        }
      }
    },
    "“%@” is not a login.": {
      "localizations": {
