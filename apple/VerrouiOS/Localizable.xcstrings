    "Kept on this iPhone. “Last used” follows what you fill, copy or show here: only item IDs and dates, never sent to the server.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardés sur cet iPhone. « Dernière utilisation » suit ce que vous remplissez, copiez ou affichez ici : seulement des identifiants d'éléments et des dates, jamais envoyés au serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem iPhone gespeichert. „Zuletzt verwendet“ folgt dem, was du hier ausfüllst, kopierst oder anzeigst: nur Eintrags-IDs und Daten, nie an den Server gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda en este iPhone. “Último uso” sigue lo que rellenas, copias o muestras aquí: solo identificadores de elementos y fechas, nunca se envían al servidor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservato su questo iPhone. “Ultimo utilizzo” segue ciò che compili, copi o mostri qui: solo ID degli elementi e date, mai inviati al server."
          }
        }
      }
    },
