    "Titles, usernames, sites, tags: no need for capitals or accents.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Titres, identifiants, sites, étiquettes : sans majuscules ni accents."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel, Benutzernamen, Websites, Tags: Großbuchstaben oder Akzente sind nicht nötig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos, nombres de usuario, sitios, etiquetas: no hacen falta mayúsculas ni acentos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Titoli, nomi utente, siti, tag: non servono maiuscole o accenti."
          }
        }
      }
    },
    "To allow in System Settings → General → Login Items.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À autoriser dans Réglages Système → Général → Ouverture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In „Systemeinstellungen → Allgemein → Anmeldeobjekte“ zu erlauben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para permitirlo en Ajustes del Sistema → General → Ítems de inicio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da consentire in Impostazioni di Sistema → Generali → Elementi login."
          }
        }
      }
    },
    "To check": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À vérifier"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu prüfen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
