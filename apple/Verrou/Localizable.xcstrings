            "state": "translated",
            "value": "Has abandonado %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai lasciato %@"
          }
        }
      }
    },
    "You must be able to edit the item and see its password": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut pouvoir modifier l'élément et en voir le mot de passe"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst den Eintrag bearbeiten und sein Passwort sehen können"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes poder editar el elemento y ver su contraseña"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Devi poter modificare l'elemento e vederne la password"
          }
        }
      }
    },
    "You now have access to %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez maintenant accès à %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast jetzt Zugriff auf %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora tienes acceso a %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora hai accesso a %@."
          }
        }
      }
    },
    "You will be able to choose a new master password for their account (from the web vault).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez choisir un nouveau mot de passe principal pour son compte (depuis le coffre web)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst ein neues Master-Passwort für den Account der Person wählen (über den Web-Tresor)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrás elegir una nueva contraseña maestra para su cuenta (desde la bóveda web)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrai scegliere una nuova password principale per il suo account (dalla cassaforte web)."
          }
        }
      }
    },
    "You will be able to see the items of their vault, without changing them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez voir les éléments de son coffre, sans les modifier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst die Einträge des Tresors der Person sehen, ohne sie zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrás ver los elementos de su bóveda, sin modificarlos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrai vedere gli elementi della sua cassaforte, senza modificarli."
          }
        }
      }
    },
    "You will be asked for the key twice: to create its credential, then to read its secret.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé vous sera demandée deux fois : pour créer son accréditation, puis pour lire son secret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst zweimal nach dem Schlüssel gefragt: um seine Anmeldedaten zu erstellen und dann, um sein Geheimnis zu lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se te pedirá la llave dos veces: para crear su credencial y luego para leer su secreto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave ti verrà chiesta due volte: per creare la sua credenziale, poi per leggerne il segreto."
          }
        }
      }
    },
    "You will need the master password and the second factor to come back.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faudra le mot de passe principal et le second facteur pour revenir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du benötigst das Master-Passwort und den zweiten Faktor, um zurückzukommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitarás la contraseña maestra y el segundo factor para volver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per tornare serviranno la password principale e il secondo fattore."
          }
        }
      }
    },
    "You will need your master password and your second factor to log in again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faudra votre mot de passe principal et votre second facteur pour vous reconnecter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du benötigst dein Master-Passwort und deinen zweiten Faktor, um dich erneut anzumelden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitarás tu contraseña maestra y tu segundo factor para volver a iniciar sesión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per accedere di nuovo serviranno la password principale e il secondo fattore."
          }
        }
      }
    },
    "You will no longer be able to log in to this site with it. Also remove it from the site's security settings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pourrez plus vous connecter à ce site avec elle. Retirez-la aussi des réglages de sécurité du site."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst dich damit nicht mehr bei dieser Website anmelden. Entferne ihn auch aus den Sicherheitseinstellungen der Website."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no podrás iniciar sesión en este sitio con ella. Elimínala también de los ajustes de seguridad del sitio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non potrai più accedere a questo sito con essa. Rimuovila anche dalle impostazioni di sicurezza del sito."
          }
        }
      }
    },
    "Your Vaultwarden vault, on your iPhone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre coffre Vaultwarden, sur votre iPhone."
