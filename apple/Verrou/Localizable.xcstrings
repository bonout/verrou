    "%@ needs to be turned on again: enter your master password.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ doit être réactivé : saisissez votre mot de passe principal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ muss erneut aktiviert werden: Gib dein Master-Passwort ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay que volver a activar %@: introduce tu contraseña maestra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deve essere riattivato: inserisci la password principale."
          }
        }
      }
    },
    "%@ passwords checked": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mots de passe examinés"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Passwörter geprüft"
          }
        },
        "es": {
          "stringUnit": {
