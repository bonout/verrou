    "Access revoked: they no longer see anything of the organization. Restore gives them back their previous access.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès révoqué : il ne voit plus rien de l'organisation. Restaurer lui rend son accès d'avant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff widerrufen: Diese Person sieht nichts mehr von der Organisation. „Wiederherstellen“ gibt ihr den vorherigen Zugriff zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso revocado: ya no ve nada de la organización. Restaurar le devuelve el acceso que tenía."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso revocato: non vede più nulla dell'organizzazione. Ripristina gli restituisce l'accesso precedente."
          }
        }
      }
    },
