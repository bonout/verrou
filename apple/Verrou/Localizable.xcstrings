    "Its items stay in the organization": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses éléments restent dans l'organisation"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus elementos se quedan en la organización"
          }
        },
