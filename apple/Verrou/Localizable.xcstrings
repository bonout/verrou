    "Icons come from your Vaultwarden server, which only receives the names of the sites; they are not kept on disk.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les icônes viennent de votre serveur Vaultwarden, qui ne reçoit que le nom des sites ; elles ne sont pas gardées sur le disque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbole kommen von deinem Vaultwarden-Server, der nur die Namen der Websites erhält; sie werden nicht auf dem Datenträger gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los iconos proceden de tu servidor Vaultwarden, que solo recibe los nombres de los sitios; no se guardan en el disco."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le icone provengono dal tuo server Vaultwarden, che riceve solo i nomi dei siti; non vengono conservate sul disco."
          }
        }
      }
    },
