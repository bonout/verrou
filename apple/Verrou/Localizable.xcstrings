    "Looks like an existing item (same site or same title, same username). Replace keeps the old password in the item's history.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ressemble à un élément existant (même site ou même titre, même identifiant). Remplacer garde l'ancien mot de passe dans l'historique de l'élément."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ähnelt einem vorhandenen Eintrag (gleiche Website oder gleicher Titel, gleicher Benutzername). „Ersetzen“ behält das alte Passwort im Verlauf des Eintrags."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se parece a un elemento existente (mismo sitio o mismo título, mismo nombre de usuario). Sustituir conserva la contraseña antigua en el historial del elemento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembra un elemento esistente (stesso sito o stesso titolo, stesso nome utente). Sostituisci conserva la vecchia password nella cronologia dell'elemento."
          }
        }
      }
    },
