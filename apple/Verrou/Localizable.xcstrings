        }
      }
    },
    "Terminal: “verrou link”, then each secret or SSH signature asks for Touch ID.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal : « verrou link », puis chaque secret ou signature SSH demande Touch ID."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal: „verrou link“, danach fragt jedes Geheimnis und jede SSH-Signatur nach Touch ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal: “verrou link”; después, cada secreto o firma SSH pide Touch ID."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminale: “verrou link”, poi ogni segreto o firma SSH chiede Touch ID."
          }
        }
      }
    },
    "Text": {
      "localizations": {
