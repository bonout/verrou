    "1 unsynced change will be lost. You will need your master password and your second factor to log in again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 modification non synchronisée sera perdue. Il faudra votre mot de passe principal et votre second facteur pour vous reconnecter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 nicht synchronisierte Änderung geht verloren. Du benötigst dein Master-Passwort und deinen zweiten Faktor, um dich erneut anzumelden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perderá 1 cambio no sincronizado. Necesitarás tu contraseña maestra y tu segundo factor para volver a iniciar sesión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1 modifica non sincronizzata andrà persa. Per accedere di nuovo serviranno la password principale e il secondo fattore."
          }
        }
      }
    },
    "1. Open **Settings → General → AutoFill & Passwords**.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Ouvrez **Réglages → Général → Remplissage automatique et mots de passe**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Öffne **Einstellungen → Allgemein → Automatisch ausfüllen & Passwörter**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Abre **Ajustes → General → Autorrelleno y contraseñas**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Apri **Impostazioni → Generali → Riempimento automatico e password**."
          }
        }
      }
    },
