    "PBKDF2: the default setting of the Bitwarden apps. Argon2id better withstands graphics card attacks.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PBKDF2 : le réglage par défaut des apps Bitwarden. Argon2id résiste mieux aux attaques par carte graphique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PBKDF2: die Standardeinstellung der Bitwarden-Apps. Argon2id widersteht Angriffen mit Grafikkarten besser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PBKDF2: el ajuste por omisión de las apps de Bitwarden. Argon2id resiste mejor los ataques con tarjetas gráficas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PBKDF2: l'impostazione predefinita delle app Bitwarden. Argon2id resiste meglio agli attacchi con schede grafiche."
          }
        }
      }
    },
