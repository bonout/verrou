    },
    "Entrust your vault to someone close, or open the one someone close entrusted to you": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confier son coffre à un proche, ou ouvrir celui qu'un proche vous a confié"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertraue deinen Tresor einer nahestehenden Person an oder öffne den, den dir eine nahestehende Person anvertraut hat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confía tu bóveda a alguien cercano, o abre la que alguien cercano te ha confiado"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Affida la tua cassaforte a una persona vicina, o apri quella che una persona vicina ti ha affidato"
          }
        }
      }
    },
