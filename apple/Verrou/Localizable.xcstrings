            "value": "Toca + para crear uno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca + per crearne uno."
          }
        }
      }
    },
    "Tap the eye to show the note.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez l'œil pour afficher la note."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf das Auge, um die Notiz anzuzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
