    "On": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activée"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein"
          }
        },
        "es": {
