        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrá ver los elementos de tu bóveda, sin modificarlos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrà vedere gli elementi della tua cassaforte, senza modificarli."
          }
        }
      }
    },
    "They will no longer see the organization's items. You can restore their access.": {
      "localizations": {
