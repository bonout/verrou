    "%@ unsynced changes will be lost. You will need your master password and your second factor to log in again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ modifications non synchronisées seront perdues. Il faudra votre mot de passe principal et votre second facteur pour vous reconnecter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perderán %@ cambios no sincronizados. Necesitarás tu contraseña maestra y tu segundo factor para volver a iniciar sesión."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perderán %@ cambios no sincronizados. Necesitarás tu contraseña maestra y tu segundo factor para volver a iniciar sesión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ modifiche non sincronizzate andranno perse. Per accedere di nuovo serviranno la password principale e il secondo fattore."
          }
        }
      }
    },
    "%@ will be notified. Unless they decline, access will be granted to you in %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sera prévenu. Sans refus de sa part, l'accès vous sera accordé dans %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Se avisará a %@. Salvo que lo rechace, se te concederá acceso en %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se avisará a %@. Salvo que lo rechace, se te concederá acceso en %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ riceverà una notifica. Se non rifiuta, otterrai l'accesso tra %@."
          }
        }
      }
    },
