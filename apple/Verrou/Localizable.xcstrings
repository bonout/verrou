    },
    "To confirm: check their fingerprint": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À confirmer : vérifiez son empreinte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu bestätigen: Prüfe den Fingerabdruck"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por confirmar: comprueba su huella digital"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da confermare: verifica la sua impronta"
          }
        }
      }
    },
    "To decide": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À décider"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
