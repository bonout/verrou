    "%@ is requesting access to your vault. Deny it in Verrou if you weren't expecting it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ demande l'accès à votre coffre. Refusez dans Verrou si vous ne l'attendiez pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fordert Zugriff auf deinen Tresor an. Lehne ihn in Verrou ab, wenn du nicht damit gerechnet hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ solicita acceso a tu bóveda. Deniégalo en Verrou si no lo esperabas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chiede l'accesso alla tua cassaforte. Rifiutalo in Verrou se non te lo aspettavi."
          }
        }
      }
    },
    "%@ is requesting many items in a short time: allow “%@”": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ demande beaucoup d'éléments en peu de temps : autoriser « %2$@ »"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fordert in kurzer Zeit viele Einträge an: „%@“ erlauben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ solicita muchos elementos en poco tiempo: permitir “%@”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ richiede molti elementi in poco tempo: consenti “%@”"
          }
        }
      }
    },
