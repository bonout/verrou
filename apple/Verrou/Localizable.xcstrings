          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da controllare"
          }
        }
      }
    },
    "To compare with the one seen by the person who confirms you (organization or emergency access)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À comparer avec celle que voit la personne qui vous confirme (organisation ou accès d'urgence)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Vergleich mit der Phrase, die die Person sieht, die dich bestätigt (Organisation oder Notfallzugriff)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para compararla con la que ve la persona que te confirma (organización o acceso de emergencia)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da confrontare con quella vista dalla persona che ti conferma (organizzazione o accesso di emergenza)"
          }
        }
      }
    },
    "To confirm": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À confirmer"
          }
        },
        "de": {
