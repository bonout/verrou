        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus secretos requieren una confirmación (Touch ID o contraseña maestra)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I suoi segreti richiedono una conferma (Touch ID o password principale)"
          }
        }
      }
    },
