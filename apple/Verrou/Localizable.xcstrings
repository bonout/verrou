    "Invitation sent. The person creates their account with the link received by email (in Verrou: “Create an Account” on the login screen), then accepts it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitation envoyée. La personne crée son compte avec le lien reçu par e-mail (dans Verrou : « Créer un compte » sur l'écran de connexion), puis l'accepte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einladung gesendet. Die Person erstellt ihren Account mit dem per E-Mail erhaltenen Link (in Verrou: „Account erstellen“ auf dem Anmeldebildschirm) und nimmt sie dann an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitación enviada. La persona crea su cuenta con el enlace recibido por correo electrónico (en Verrou: “Crear una cuenta” en la pantalla de inicio de sesión) y luego la acepta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invito inviato. La persona crea il proprio account con il link ricevuto via email (in Verrou: “Crea un account” nella schermata di login), poi lo accetta."
          }
        }
      }
    },
