    },
    "Only a resemblance: check before deleting.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une ressemblance seulement : vérifiez avant de supprimer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur eine Ähnlichkeit: Prüfe vor dem Löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo es un parecido: compruébalo antes de eliminar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo una somiglianza: verifica prima di eliminare."
          }
        }
      }
    },
    "Only an owner can give the manager, administrator or owner roles.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul un propriétaire peut donner les rôles de gestionnaire, d'administrateur ou de propriétaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ein:e Eigentümer:in kann die Rollen Manager:in, Administrator:in oder Eigentümer:in vergeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un propietario puede asignar los roles de gestor, administrador o propietario."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un proprietario può assegnare i ruoli di gestore, amministratore o proprietario."
          }
        }
      }
    },
    "Only an owner gives the manager, administrator or owner roles.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul un propriétaire donne les rôles de gestionnaire, d'administrateur ou de propriétaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ein:e Eigentümer:in vergibt die Rollen Manager:in, Administrator:in oder Eigentümer:in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un propietario asigna los roles de gestor, administrador o propietario."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un proprietario assegna i ruoli di gestore, amministratore o proprietario."
          }
        }
      }
    },
    "Only files can be attached or sent (not folders).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les fichiers peuvent être joints ou envoyés (pas les dossiers)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Dateien können angehängt oder gesendet werden (keine Ordner)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se pueden adjuntar o enviar archivos (no carpetas)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si possono allegare o inviare solo file (non cartelle)."
          }
        }
      }
    },
    "Only the first 5 characters of each password's SHA-1 hash leave the iPhone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les 5 premiers caractères de l'empreinte SHA-1 de chaque mot de passe quittent l'iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die ersten 5 Zeichen des SHA-1-Hashs jedes Passworts verlassen das iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo salen del iPhone los 5 primeros caracteres del hash SHA-1 de cada contraseña."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo i primi 5 caratteri dell'hash SHA-1 di ogni password lasciano l'iPhone."
          }
        }
      }
    },
    "Only this exact address.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
