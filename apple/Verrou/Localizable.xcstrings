    " (offline conflict)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " (conflit hors ligne)"
          }
        }
      }
    },
    "#%@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "#%@"
          }
        }
      }
    },
    "%@ accesses at most": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ accès au plus"
          }
        }
      }
    },
    "%@ copied": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ copié"
          }
        }
      }
    },
    "%@ copied (cleared from the clipboard in 90 s).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ copié (effacé du presse-papiers dans 90 s)."
          }
        }
      }
    },
    "%@ copied.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ copié."
          }
        }
      }
    },
    "%@ in any app: Verrou offers the logins linked to that app, then types the username, Tab and the password. ⌘↩ links the chosen login to the app (synced with the vault). The key is the one left of Return.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dans n'importe quelle app : Verrou propose les identifiants associés à cette app, puis tape l'identifiant, Tab et le mot de passe. ⌘↩ associe l'identifiant choisi à l'app (synchronisé avec le coffre). La touche est celle à gauche de Retour."
          }
        }
      }
    },
    "%@ is already taken by another app: choose another combination.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est déjà pris par une autre app : choisissez une autre combinaison."
          }
        }
      }
    },
    "%@ is confirmed": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est confirmé"
          }
        }
      }
    },
    "%@ is confirmed as an emergency contact.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est confirmé comme contact d'urgence."
          }
        }
      }
    },
    "%@ is confirmed: they have access to the shared collections.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est confirmé : il a accès aux collections partagées."
          }
        }
      }
    },
    "%@ is no longer part of the organization": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne fait plus partie de l'organisation"
          }
        }
      }
    },
    "%@ is no longer part of the organization.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne fait plus partie de l'organisation."
          }
        }
      }
    },
    "%@ is not available.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'est pas disponible."
          }
        }
      }
    },
    "%@ is not available: enter your master password.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'est pas disponible : saisissez votre mot de passe principal."
          }
        }
      }
    },
    "%@ is not set up on this iPhone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'est pas configuré sur cet iPhone."
          }
        }
      }
    },
    "%@ is requesting access to your vault. Deny it in Verrou if you weren't expecting it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ demande l'accès à votre coffre. Refusez dans Verrou si vous ne l'attendiez pas."
          }
        }
      }
    },
    "%@ is requesting many items in a short time: allow “%@”": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ demande beaucoup d'éléments en peu de temps : autoriser « %2$@ »"
          }
        }
      }
    },
    "%@ items selected": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ éléments sélectionnés"
          }
        }
      }
    },
    "%@ needs to be turned on again: enter your master password.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ doit être réactivé : saisissez votre mot de passe principal."
          }
        }
      }
    },
    "%@ passwords checked": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mots de passe examinés"
          }
        }
      }
    },
    "%@ unsynced changes will be lost. You will need your master password and your second factor to log in again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ modifications non synchronisées seront perdues. Il faudra votre mot de passe principal et votre second facteur pour vous reconnecter."
          }
        }
      }
    },
    "%@ will be notified. Unless they decline, access will be granted to you in %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sera prévenu. Sans refus de sa part, l'accès vous sera accordé dans %2$@."
          }
        }
      }
    },
