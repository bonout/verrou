    "Erases the account, the encrypted cache and %@ from this iPhone. Your vault stays on the server.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface le compte, le cache chiffré et %@ de cet iPhone. Votre coffre reste sur le serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht den Account, den verschlüsselten Cache und %@ von diesem iPhone. Dein Tresor bleibt auf dem Server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra de este iPhone la cuenta, la caché cifrada y %@. Tu bóveda se queda en el servidor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella l'account, la cache cifrata e %@ da questo iPhone. La tua cassaforte resta sul server."
          }
        }
      }
    },
    "Erases the cache, the tokens and the changes not yet synced from this Mac. The vault stays intact on the server.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface le cache, les jetons et les modifications pas encore synchronisées de ce Mac. Le coffre reste intact sur le serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht den Cache, die Tokens und die noch nicht synchronisierten Änderungen von diesem Mac. Der Tresor bleibt auf dem Server unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra de este Mac la caché, los tokens y los cambios aún no sincronizados. La bóveda se queda intacta en el servidor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella da questo Mac la cache, i token e le modifiche non ancora sincronizzate. La cassaforte resta intatta sul server."
          }
        }
      }
    },
