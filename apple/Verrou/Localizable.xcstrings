        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrou füllt deine Logins, Codes und Passkeys in Safari und den Apps des Mac aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrou rellena tus inicios de sesión, códigos y llaves de acceso en Safari y en las apps del Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrou compila i tuoi login, codici e passkey in Safari e nelle app del Mac."
          }
        }
      }
    },
