            "value": "I suoi elementi restano nell'organizzazione"
          }
        }
      }
    },
    "Its items stay in the organization: administrators still see them, the other members only through their other collections.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses éléments restent dans l'organisation : les administrateurs les voient toujours, les autres membres seulement par leurs autres collections."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus elementos se quedan en la organización: los administradores siguen viéndolos y los demás miembros solo a través de sus otras colecciones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus elementos se quedan en la organización: los administradores siguen viéndolos y los demás miembros solo a través de sus otras colecciones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I suoi elementi restano nell'organizzazione: gli amministratori li vedono ancora, gli altri membri solo tramite le loro altre raccolte."
          }
        }
      }
    },
    "Its items stay in the organization: the administrators still see them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses éléments restent dans l'organisation : les administrateurs les voient toujours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus elementos se quedan en la organización: los administradores siguen viéndolos."
          }
        },
