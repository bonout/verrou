    "Matching decides on which pages Verrou offers the login; it is saved with the item, as in Bitwarden.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La correspondance décide des pages où Verrou propose l'identifiant ; elle est enregistrée avec l'élément, comme dans Bitwarden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Abgleich bestimmt, auf welchen Seiten Verrou das Login anbietet; er wird wie in Bitwarden mit dem Eintrag gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La coincidencia decide en qué páginas ofrece Verrou el inicio de sesión; se guarda con el elemento, como en Bitwarden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La corrispondenza decide su quali pagine Verrou propone il login; viene salvata con l'elemento, come in Bitwarden."
          }
        }
      }
    },
    "Matching decides the pages where the login is offered; it is saved with the item, as in Bitwarden.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La correspondance décide des pages où l'identifiant est proposé ; elle est enregistrée avec l'élément, comme dans Bitwarden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Abgleich bestimmt die Seiten, auf denen das Login angeboten wird; er wird wie in Bitwarden mit dem Eintrag gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La coincidencia decide las páginas en las que se ofrece el inicio de sesión; se guarda con el elemento, como en Bitwarden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La corrispondenza decide le pagine in cui viene proposto il login; viene salvata con l'elemento, come in Bitwarden."
          }
        }
      }
    },
