    "Create a send here, drop a file on this list, or start from an item or an attachment: right-click → “Send Securely…”.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un envoi ici, déposez un fichier sur cette liste, ou partez d'un élément ou d'une pièce jointe : clic droit → « Envoyer de façon sécurisée… »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle hier ein Send, lege eine Datei auf dieser Liste ab oder beginne mit einem Eintrag oder Anhang: Rechtsklick → „Sicher senden …“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un envío aquí, suelta un archivo en esta lista o parte de un elemento o un archivo adjunto: clic derecho → “Enviar de forma segura…”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un Send qui, trascina un file su questo elenco oppure parti da un elemento o da un allegato: clic destro → “Invia in modo sicuro…”."
          }
        }
      }
    },
    "Create a shared vault, then invite other accounts of your server to it": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un coffre partagé, puis invitez-y d'autres comptes de votre serveur"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle einen geteilten Tresor und lade dann andere Accounts deines Servers dazu ein"
          }
        },
