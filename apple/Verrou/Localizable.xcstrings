          }
        }
      }
    },
    "On unlock, show": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au déverrouillage, afficher"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Al desbloquear, mostrar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al desbloquear, mostrar"
          }
        },
        "it": {
