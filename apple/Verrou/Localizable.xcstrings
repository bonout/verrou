          "stringUnit": {
            "state": "translated",
            "value": "Nom"
          }
        }
      }
    },
    "Swipe a collection to the left to edit or delete it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez une collection vers la gauche pour la modifier ou la supprimer."
          }
        }
      }
    },
    "Swipe a field to the left to delete it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez un champ vers la gauche pour le supprimer."
          }
        }
      }
    },
    "Symbols": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Symboles"
          }
        }
      }
    },
    "Sync": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniser"
          }
        }
      }
    },
    "Sync (⌘R)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniser (⌘R)"
          }
        }
      }
    },
    "Sync Now": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniser maintenant"
          }
        }
      }
    },
    "Sync failed (%@): try again": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la synchronisation (%@) : réessayer"
          }
        }
      }
    },
    "Sync in progress": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisation en cours"
          }
        }
      }
    },
    "Sync now": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniser maintenant"
          }
        }
      }
    },
    "Synced": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisé"
          }
        }
      }
    },
    "Synced at %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisé à %@"
          }
        }
      }
    },
    "Syncing…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisation…"
          }
        }
      }
    },
    "System Settings → Privacy & Security → Accessibility": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages Système → Confidentialité et sécurité → Accessibilité"
          }
        }
      }
    },
    "System passwords and passkeys": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mots de passe et passkeys du système"
          }
        }
      }
    },
    "Tags": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étiquettes"
          }
        }
      }
    },
    "Takeover": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prise de contrôle"
          }
        }
      }
    },
    "Tango for Tails and the Tor project (ulif/diceware), CC0 1.0: French passphrases.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tango pour Tails et le projet Tor (ulif/diceware), CC0 1.0 : phrases de passe en français."
          }
        }
      }
    },
    "Tap + to create one.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez + pour en créer un."
          }
        }
      }
    },
    "Tap the eye to show the note.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez l'œil pour afficher la note."
          }
        }
      }
    },
    "Terminal, linked on %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal, relié le %@"
          }
        }
      }
    },
    "Terminal: “verrou link”, then each secret or SSH signature asks for Touch ID.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal : « verrou link », puis chaque secret ou signature SSH demande Touch ID."
          }
        }
      }
    },
    "Text": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte"
          }
        }
      }
    },
    "Text Send": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoi de texte"
          }
        }
      }
    },
    "The Bitwarden SDK could not decrypt them": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le SDK Bitwarden n'a pas pu les déchiffrer"
          }
        }
      }
    },
    "The Verrou extension fills your logins in Brave or Firefox, site by site; the “verrou” command and its SSH agent read the vault from the terminal, with your approval. Nothing leaves the Mac.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'extension Verrou remplit vos identifiants dans Brave ou Firefox, site par site ; la commande « verrou » et son agent SSH lisent le coffre depuis le terminal, avec votre accord. Rien ne sort du Mac."
          }
        }
      }
    },
    "The access between you and %@ will be removed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès entre vous et %@ sera retiré."
          }
        }
      }
    },
    "The attachment is permanently deleted from the server, without going through the trash.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pièce jointe est supprimée définitivement du serveur, sans passer par la corbeille."
          }
        }
      }
    },
    "The clipboard contains neither an otpauth:// link nor a QR code image.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le presse-papiers ne contient ni lien otpauth:// ni image de QR code."
          }
        }
      }
    },
    "The contact must have an account on this server. Once the invitation is accepted, you will confirm it by checking their key's fingerprint.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contact doit avoir un compte sur ce serveur. Une fois l'invitation acceptée, vous la confirmerez en vérifiant l'empreinte de sa clé."
          }
        }
      }
    },
    "The contact will be able to choose a new master password for your account (from the web vault).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contact pourra choisir un nouveau mot de passe principal pour votre compte (depuis le coffre web)."
          }
        }
      }
    },
    "The contact will be able to see the items of your vault, without changing them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contact pourra voir les éléments de votre coffre, sans les modifier."
          }
        }
      }
    },
    "The delay counts from the moment Verrou goes to the background. Out of the foreground, Verrou's screen is hidden in the app switcher.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le délai compte à partir du moment où Verrou passe en arrière-plan. Hors du premier plan, l'écran de Verrou est masqué dans le sélecteur d'apps."
          }
        }
      }
    },
    "The export file contains your passwords in the clear. Delete it, then empty the Finder's trash.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier d'export contient vos mots de passe en clair. Supprimez-le, puis videz la corbeille du Finder."
          }
        }
      }
    },
    "The export file contains your passwords in the clear: delete it after the import.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier d'export contient vos mots de passe en clair : supprimez-le après l'import."
          }
        }
      }
    },
    "The extension only receives the logins of the open site, over HTTPS, with the vault unlocked. The terminal searches without seeing the secrets; each one asks for Touch ID.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'extension ne reçoit que les identifiants du site ouvert, en HTTPS, coffre déverrouillé. Le terminal cherche sans voir les secrets ; chacun demande Touch ID."
          }
        }
      }
    },
    "The file and its name are encrypted before upload; only the link can open them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier et son nom sont chiffrés avant l'envoi ; seul le lien permet de les ouvrir."
          }
        }
      }
    },
    "The file exceeds 100 MB, the maximum size of an attachment or a send.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier dépasse 100 Mo, la taille maximale d'une pièce jointe ou d'un envoi."
          }
        }
      }
    },
    "The file is deleted from the server. This action is permanent.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est supprimé du serveur. Cette action est définitive."
          }
        }
      }
    },
    "The file is encrypted and stored in a secure note named after it (100 MB at most).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est chiffré et rangé dans une note sécurisée à son nom (100 Mo au plus)."
          }
        }
      }
    },
    "The file is encrypted before being sent; only the link can open it (100 MB at most).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est chiffré avant d'être envoyé ; seul le lien permet de l'ouvrir (100 Mo au plus)."
          }
        }
      }
    },
    "The file of a send can't be replaced: create a new send for another file.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier d'un envoi ne peut pas être remplacé : créez un nouvel envoi pour un autre fichier."
          }
        }
      }
    },
    "The hint must not be the password.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'indice ne doit pas être le mot de passe."
          }
        }
      }
    },
    "The iPhone's answer doesn't match this QR code.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse de l’iPhone ne correspond pas à ce QR code."
          }
        }
      }
    },
    "The item can be restored from the trash for 30 days.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'élément reste restaurable depuis la corbeille pendant 30 jours."
          }
        }
      }
    },
    "The item changed elsewhere in the meantime. Verrou just reloaded it: open it again to redo the change.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'élément a changé ailleurs entre-temps. Verrou vient de le recharger : rouvrez-le pour refaire la modification."
          }
        }
      }
    },
    "The item changed elsewhere in the meantime. Verrou just reloaded it: reopen it to redo the change.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'élément a changé ailleurs entre-temps. Verrou vient de le recharger : rouvrez-le pour refaire la modification."
          }
        }
      }
    },
    "The item changed on the server: sync, then try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'élément a changé sur le serveur : synchronisez, puis recommencez."
          }
        }
      }
    },
    "The item leaves your personal vault: it is re-encrypted with the organization's key, and its members see it according to their permissions.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'élément quitte votre coffre personnel : il est rechiffré avec la clé de l'organisation, et ses membres le voient selon leurs droits."
          }
        }
      }
    },
    "The item leaves your personal vault: it is re-encrypted with the organization's key, and its members see it according to their rights.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'élément quitte votre coffre personnel : il est rechiffré avec la clé de l'organisation, et ses membres le voient selon leurs droits."
          }
        }
      }
    },
    "The item stays restorable from the web vault for 30 days.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'élément reste restaurable depuis le coffre web pendant 30 jours."
          }
        }
      }
    },
    "The items stay restorable from the web vault for 30 days.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments restent restaurables depuis le coffre web pendant 30 jours."
          }
        }
      }
    },
    "The keyboard suggestions already take them into account. Verrou deletes nothing: open the item to remove the passkey or the password if you wish.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les suggestions du clavier en tiennent déjà compte. Verrou ne supprime rien : ouvrez l'élément pour retirer la passkey ou le mot de passe si vous le souhaitez."
          }
        }
      }
    },
    "The link carries the Send's key: only give it to its recipient. It is cleared from the clipboard after the set delay.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien porte la clé de l'envoi : ne le donnez qu'à son destinataire. Il est effacé du presse-papiers après le délai réglé."
          }
        }
      }
    },
    "The link no longer leads to the content: disabled, expired or access count reached": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien ne mène plus au contenu : désactivé, expiré ou nombre d'accès atteint"
          }
        }
      }
    },
    "The link only opens where the server is reachable: on its network, or through its VPN if it isn't public.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien ne s'ouvre que là où le serveur est joignable : sur son réseau, ou par son VPN s'il n'est pas public."
          }
        }
      }
    },
    "The link will no longer lead anywhere. This deletion is permanent.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien ne mènera plus à rien. Cette suppression est définitive."
          }
        }
      }
    },
    "The link will stop working.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien ne fonctionnera plus."
          }
        }
      }
    },
    "The master password can't be recovered: without it, the vault is lost.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe principal ne peut pas être récupéré : sans lui, le coffre est perdu."
          }
        }
      }
    },
    "The master password never leaves the iPhone: only a derived hash is sent to the server.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe principal ne quitte jamais l'iPhone : seule une empreinte dérivée est envoyée au serveur."
          }
        }
      }
    },
    "The members of each checked collection see the item.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les membres de chaque collection cochée voient l'élément."
          }
        }
      }
    },
    "The new name shows for all members at their next sync.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nouveau nom s'affiche chez tous les membres à leur prochaine synchronisation."
          }
        }
      }
    },
    "The organization hides it from your account": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'organisation le cache à votre compte"
          }
        }
      }
    },
    "The organization hides the password from your account; filling is still possible": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'organisation cache le mot de passe à votre compte ; le remplissage reste possible"
          }
        }
      }
    },
    "The organization hides this field for your account. Filling in the browser is still possible.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'organisation masque ce champ pour votre compte. Le remplissage dans le navigateur reste possible."
          }
        }
      }
    },
    "The other members lose it, on all their devices.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres membres le perdent, sur tous leurs appareils."
          }
        }
      }
    },
    "The password travels in clear": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe circule en clair"
          }
        }
      }
    },
    "The password travels there in the clear: Verrou doesn't fill it in Brave.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe y circule en clair : Verrou ne le remplit pas dans Brave."
          }
        }
      }
    },
    "The person accepts with this link: “Join an organization” if they have an account, otherwise “Create an account”.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La personne accepte avec ce lien : « Rejoindre une organisation » si elle a un compte, sinon « Créer un compte »."
          }
        }
      }
    },
    "The person accepts: in Verrou, “Join an organization” by pasting the link, or in the web vault.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La personne accepte : dans Verrou, « Rejoindre une organisation » en collant le lien, ou dans le coffre web."
          }
        }
      }
    },
    "The person creates their account with this link (in Verrou: “Create an account”), which accepts the invitation.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La personne crée son compte avec ce lien (dans Verrou : « Créer un compte »), ce qui accepte l'invitation."
          }
        }
      }
    },
    "The private key stays in the vault: Verrou's SSH agent signs for ssh and git, after your approval.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé privée reste dans le coffre : l'agent SSH de Verrou signe pour ssh et git, après votre accord."
          }
        }
      }
    },
    "The remaining groups are ignored.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les groupes restants sont ignorés."
          }
        }
      }
    },
    "The role and collections replace the previous ones.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rôle et les collections remplacent les précédents."
          }
        }
      }
    },
    "The same account, imported several times: addresses, titles and usernames compared. The certain copies are checked.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le même compte, importé plusieurs fois : adresses, titres et identifiants comparés. Les copies certaines sont cochées."
          }
        }
      }
    },
    "The same host, port included: not the subdomains.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le même hôte, port compris : pas les sous-domaines."
          }
        }
      }
    },
    "The same password on several sites: a leak at one opens the others.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un même mot de passe sur plusieurs sites : une fuite chez l'un ouvre les autres."
          }
        }
      }
    },
    "The saved copy will not be encrypted.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie enregistrée ne sera pas chiffrée."
          }
        }
      }
    },
    "The security key did not respond: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de sécurité n'a pas répondu : %@"
          }
        }
      }
    },
    "The seed goes encrypted into the item. Nothing is copied or kept: neither the image nor the QR code's text.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La graine part chiffrée dans l'élément. Rien n'est copié ni conservé : ni image, ni texte du QR code."
          }
        }
      }
    },
    "The server replied: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a répondu : %@"
          }
        }
      }
    },
    "The server sends an invitation link to each address.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur envoie un lien d'invitation à chaque adresse."
          }
        }
      }
    },
    "The server%@ sends an email to %@, subject “Join …”. If it doesn't arrive: spam, then “Resend invitation”.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur%1$@ envoie un e-mail à %2$@, sujet « Join … ». S'il n'arrive pas : indésirables, puis « Renvoyer l'invitation »."
          }
        }
      }
    },
    "The session has expired: sign in again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session a expiré : reconnectez-vous."
          }
        }
      }
    },
    "The site and all its subdomains (and equivalent domains).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le site et tous ses sous-domaines (et les domaines équivalents)."
          }
        }
      }
    },
    "The site will no longer recognize you with it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le site ne vous reconnaîtra plus avec elle."
          }
        }
      }
    },
    "The system only receives the sites and user names, for its suggestions. Passwords, codes and passkeys only leave the vault after %@ or your master password.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le système ne reçoit que les sites et noms d'utilisateur, pour ses suggestions. Les mots de passe, codes et passkeys ne sortent du coffre qu'après %@ ou votre mot de passe principal."
          }
        }
      }
    },
    "The takeover (new master password) is done from the web vault": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prise de contrôle (nouveau mot de passe principal) est à faire depuis le coffre web"
          }
        }
      }
    },
    "The two passwords differ.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux mots de passe diffèrent."
          }
        }
      }
    },
    "The vault is locked.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coffre est verrouillé."
          }
        }
      }
    },
    "The vault key is sealed by the Secure Enclave: adding or removing a fingerprint turns off Touch ID.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé du coffre est scellée par le Secure Enclave : ajouter ou retirer une empreinte désactive Touch ID."
          }
        }
      }
    },
    "Their account stays on the server. To come back, they will need a new invitation.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son compte reste sur le serveur. Pour revenir, il lui faudra une nouvelle invitation."
          }
        }
      }
    },
    "Their account stays on the server; to bring them back, you will need to invite them again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son compte reste sur le serveur ; pour le faire revenir, il faudra l'inviter de nouveau."
          }
        }
      }
    },
    "These items are shared read-only": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagés en lecture seule"
          }
        }
      }
    },
    "These items leave your personal vault: each one is re-encrypted with the organization's key (attachments included), and its members see them according to their rights.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces éléments quittent votre coffre personnel : chacun est rechiffré avec la clé de l'organisation (pièces jointes comprises), et ses membres les voient selon leurs droits."
          }
        }
      }
    },
    "These items leave your personal vault: each one is re-encrypted with the organization's key (attachments included).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces éléments quittent votre coffre personnel : chacun est rechiffré avec la clé de l'organisation (pièces jointes comprises)."
          }
        }
      }
    },
    "These passwords circulate in public leaks: change them first.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces mots de passe circulent dans des fuites publiques : changez-les en premier."
          }
        }
      }
    },
    "These sites accept passkeys: nothing to remember, nothing to phish. “Create a Passkey” opens the site's page; the Verrou extension for Brave or Firefox then offers to save it in the item. According to passkeys.2fa.directory": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces sites acceptent les passkeys : rien à retenir, rien à hameçonner. « Créer une passkey » ouvre la page du site ; l'extension Verrou de Brave ou Firefox propose ensuite de l'enregistrer dans l'élément. D'après passkeys.2fa.directory"
          }
        }
      }
    },
    "These sites accept passkeys: nothing to remember, nothing to phish. “Create” opens the site's page in Safari; choose Verrou to save the passkey. The item leaves the list at the next sync; keep the password as a fallback, or remove it at the site if it allows signing in without a password. According to passkeys.2fa.directory": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces sites acceptent les passkeys : rien à retenir, rien à hameçonner. « Créer » ouvre la page du site dans Safari ; choisissez Verrou pour enregistrer la passkey. L'élément quitte la liste à la synchronisation suivante ; gardez le mot de passe en secours, ou retirez-le chez le site s'il permet la connexion sans mot de passe. D'après passkeys.2fa.directory"
          }
        }
      }
    },
    "These sites offer two-factor authentication, but no one-time code is saved in Verrou. According to 2fa.directory": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces sites proposent la double authentification, mais aucun code à usage unique n'est enregistré dans Verrou. D'après 2fa.directory"
          }
        }
      }
    },
    "They accepted the invitation: check their fingerprint phrase to give them access": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils ont accepté l'invitation : vérifiez leur phrase d'empreinte pour leur donner accès"
          }
        }
      }
    },
    "They accepted the invitation: verify their fingerprint phrase with them to give them the organization's key.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils ont accepté l'invitation : vérifiez leur phrase d'empreinte avec eux pour leur donner la clé de l'organisation."
          }
        }
      }
    },
    "They can be restored from the web vault": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurables depuis le coffre web"
          }
        }
      }
    },
    "They chose you": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils vous ont choisi"
          }
        }
      }
    },
    "They no longer see anything of the organization; you can restore their access.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne voit plus rien de l'organisation ; vous pourrez restaurer son accès."
          }
        }
      }
    },
    "They will be able to choose a new master password for your account (from the web vault).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pourra choisir un nouveau mot de passe principal pour votre compte (depuis le coffre web)."
          }
        }
      }
    },
    "They will be able to see the items of your vault, without changing them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pourra voir les éléments de votre coffre, sans les modifier."
          }
        }
      }
    },
    "They will no longer see the organization's items. You can restore their access.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne verra plus les éléments de l'organisation. Vous pourrez restaurer son accès."
          }
        }
      }
    },
    "This Mac has no Secure Enclave.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac n’a pas de Secure Enclave."
          }
        }
      }
    },
    "This Mac's rule: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle de ce Mac : %@"
          }
        }
      }
    },
    "This QR code contains no account.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce QR code ne contient aucun compte."
          }
        }
      }
    },
    "This form": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce formulaire"
          }
        }
      }
    },
    "This invitation is for an address other than this account's.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette invitation vise une autre adresse que celle de ce compte."
          }
        }
      }
    },
    "This invitation is meant for another address than this account's.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette invitation est destinée à une autre adresse que celle de ce compte."
          }
        }
      }
    },
    "This item has no one-time code.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément n'a pas de code à usage unique."
          }
        }
      }
    },
    "This item has no public key": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément n'a pas de clé publique"
          }
        }
      }
    },
    "This item is protected: confirm your identity first.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément est protégé : confirmez d'abord votre identité."
          }
        }
      }
    },
    "This item is read-only for your account.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément est en lecture seule pour votre compte."
          }
        }
      }
    },
    "This site doesn't accept ES256 keys: use another manager.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce site n'accepte pas les clés ES256 : utilisez un autre gestionnaire."
          }
        }
      }
    },
    "This site doesn't indicate its passkeys page": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce site n'indique pas sa page de passkeys"
          }
        }
      }
    },
    "This site doesn't state its change-password page: opening the home page": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce site n'indique pas sa page de changement de mot de passe : ouverture de l'accueil"
          }
        }
      }
    },
    "This site doesn't state its passkeys page: opening the home page": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce site n'indique pas sa page de passkeys : ouverture de l'accueil"
          }
        }
      }
    },
    "Title": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Titre"
          }
        }
      }
    },
    "Titles, usernames, sites, tags: no need for capitals or accents.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Titres, identifiants, sites, étiquettes : sans majuscules ni accents."
          }
        }
      }
    },
    "To allow in System Settings → General → Login Items.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À autoriser dans Réglages Système → Général → Ouverture."
          }
        }
      }
    },
    "To check": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À vérifier"
          }
        }
      }
    },
    "To compare with the one seen by the person who confirms you (organization or emergency access)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À comparer avec celle que voit la personne qui vous confirme (organisation ou accès d'urgence)"
          }
        }
      }
    },
    "To confirm": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À confirmer"
          }
        }
      }
    },
    "To confirm: check their fingerprint": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À confirmer : vérifiez son empreinte"
          }
        }
      }
    },
    "To decide": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À décider"
          }
        }
      }
    },
    "To fill the username and password in another app, allow Verrou in System Settings → Privacy & Security → Accessibility, then press the shortcut again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour remplir l'identifiant et le mot de passe dans une autre app, autorisez Verrou dans Réglages Système → Confidentialité et sécurité → Accessibilité, puis refaites le raccourci."
          }
        }
      }
    },
    "To fill your logins, codes and passkeys in Safari and apps:": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour remplir vos identifiants, codes et passkeys dans Safari et les apps :"
          }
        }
      }
    },
    "To join a server by invitation: paste the “Join” link received by email. The keys of your vault are created on this Mac.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour rejoindre un serveur sur invitation : collez le lien « Rejoindre » reçu par e-mail. Les clés de votre coffre sont créées sur ce Mac."
          }
        }
      }
    },
    "To keep": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À garder"
          }
        }
      }
    },
    "To offer your passwords and passkeys in Safari and Mac apps, Verrou must be signed by an Apple developer team (macOS requires it of the credential provider and the shared app group): see the guide, “Mac credential provider”.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour proposer vos mots de passe et passkeys dans Safari et les apps du Mac, Verrou doit être signé par une équipe de développeur Apple (macOS l'exige du fournisseur d'identifiants et du groupe d'apps partagé) : voir le guide, « Fournisseur d'identifiants du Mac »."
          }
        }
      }
    },
    "To remove the password: “Remove Password” on the send's detail.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour retirer le mot de passe : « Retirer le mot de passe » sur la fiche de l'envoi."
          }
        }
      }
    },
    "To review": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À vérifier"
          }
        }
      }
    },
    "Too short or too simple to withstand an offline attack.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop courts ou trop simples pour résister à une attaque hors ligne."
          }
        }
      }
    },
    "Touch ID is not available on this Mac.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID n'est pas disponible sur ce Mac."
          }
        }
      }
    },
    "Touch ID is not available: enter your master password.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID n'est pas disponible : saisissez votre mot de passe principal."
          }
        }
      }
    },
    "Touch ID must be turned on again: enter your master password.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID doit être réactivé : saisissez votre mot de passe principal."
          }
        }
      }
    },
    "Touch and hold a Send to copy its link. The link carries the key: only give it to its recipient.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez longuement un envoi pour copier son lien. Le lien porte la clé : ne le donnez qu'à son destinataire."
          }
        }
      }
    },
    "Touch your YubiKey": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez votre YubiKey"
          }
        }
      }
    },
    "Touch your security key.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez votre clé de sécurité."
          }
        }
