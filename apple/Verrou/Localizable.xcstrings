    "Both the PIN and the key are needed. Logging in again or logging out removes these keys.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code PIN et la clé sont tous deux nécessaires. Une reconnexion ou une déconnexion retire ces clés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesitan tanto el PIN como la llave. Volver a iniciar sesión o cerrar sesión elimina estas llaves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
