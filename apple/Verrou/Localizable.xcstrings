    "Kept on this Mac. “Last used” follows what you fill, copy or show here: only item IDs and dates, never sent to the server.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardés sur ce Mac. « Dernière utilisation » suit ce que vous remplissez, copiez ou affichez ici : seulement des identifiants d'éléments et des dates, jamais envoyés au serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda en este Mac. “Último uso” sigue lo que rellenas, copias o muestras aquí: solo identificadores de elementos y fechas, nunca se envían al servidor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda en este Mac. “Último uso” sigue lo que rellenas, copias o muestras aquí: solo identificadores de elementos y fechas, nunca se envían al servidor."
