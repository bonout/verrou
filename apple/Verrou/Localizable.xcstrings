    "Touch and hold a Send to copy its link. The link carries the key: only give it to its recipient.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez longuement un envoi pour copier son lien. Le lien porte la clé : ne le donnez qu'à son destinataire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ein Send gedrückt, um seinen Link zu kopieren. Der Link enthält den Schlüssel: Gib ihn nur der Empfängerin oder dem Empfänger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un envío para copiar su enlace. El enlace lleva la clave: dáselo solo a su destinatario."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca e tieni premuto un Send per copiarne il link. Il link contiene la chiave: dallo solo al destinatario."
          }
        }
      }
