          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrá elegir una nueva contraseña maestra para tu cuenta (desde la bóveda web)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrà scegliere una nuova password principale per il tuo account (dalla cassaforte web)."
          }
        }
      }
    },
    "They will be able to see the items of your vault, without changing them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
