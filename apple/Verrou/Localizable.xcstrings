    "Invite an address: the person creates their account (Verrou or web vault), accepts, then you confirm them by checking their fingerprint.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez une adresse : la personne crée son compte (Verrou ou coffre web), accepte, puis vous la confirmez en vérifiant son empreinte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade eine Adresse ein: Die Person erstellt ihren Account (Verrou oder Web-Tresor), nimmt an, dann bestätigst du sie nach Prüfung ihres Fingerabdrucks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a una dirección: la persona crea su cuenta (Verrou o bóveda web), acepta y luego tú la confirmas comprobando su huella digital."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita un indirizzo: la persona crea il proprio account (Verrou o cassaforte web), accetta, poi la confermi verificandone l'impronta."
          }
        }
      }
    },
