    "Items unchanged for more than 3 years: their password dates back at least that far.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éléments inchangés depuis plus de 3 ans : leur mot de passe date au moins de cette époque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seit mehr als 3 Jahren unveränderte Einträge: Ihr Passwort ist mindestens so alt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementos sin cambios desde hace más de 3 años: su contraseña tiene al menos esa antigüedad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementi invariati da più di 3 anni: la loro password risale almeno a quel periodo."
          }
        }
      }
    },
    "Its items are no longer in your vault": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses éléments ne sont plus dans votre coffre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
