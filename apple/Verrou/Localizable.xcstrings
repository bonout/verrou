    "“%@”": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ »"
          }
        }
      }
    },
    "“%@”\n\nAsk %@ for their account's fingerprint phrase (Verrou: Settings → Account; web vault: Settings → My account). Confirm only if it is identical: the organization's key will be encrypted for this person.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ »\n\nDemandez à %2$@ la phrase d'empreinte de son compte (Verrou : Réglages → Compte ; coffre web : Paramètres → Mon compte). Confirmez seulement si elle est identique : la clé de l'organisation sera chiffrée pour cette personne."
          }
        }
      }
    },
    "“%@”\n\nAsk %@ for their account's fingerprint phrase (Verrou: Settings → Account; web vault: Settings → My account). Only confirm if it is identical: the organization's key will be encrypted for this person.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ »\n\nDemandez à %2$@ la phrase d'empreinte de son compte (Verrou : Réglages → Compte ; coffre web : Paramètres → Mon compte). Confirmez seulement si elle est identique : la clé de l'organisation sera chiffrée pour cette personne."
          }
        }
      }
    },
    "“%@”\n\nAsk %@ for their account's fingerprint phrase (web vault: Settings → My account). Only confirm if it is identical: your vault's key will be encrypted for them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ »\n\nDemandez à %2$@ la phrase d'empreinte de son compte (coffre web : Réglages → Mon compte). Confirmez seulement si elle est identique : la clé de votre coffre sera chiffrée pour lui."
          }
        }
      }
    },
    "“%@” already has a one-time code.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » a déjà un code à usage unique."
