    "On your iPhone, open an item and turn on Show in widgets and on Apple Watch.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur votre iPhone, ouvrez un élément et activez « Afficher dans les widgets et sur l'Apple Watch »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne auf deinem iPhone einen Eintrag und aktiviere „In Widgets und auf der Apple Watch zeigen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu iPhone, abre un elemento y activa «Mostrar en widgets y en el Apple Watch»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su iPhone, apri un elemento e attiva «Mostra nei widget e su Apple Watch»."
          }
        }
