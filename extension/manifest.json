{
  "manifest_version": 3,
  "name": "Verrou",
  "description": "Remplit et enregistre vos identifiants dans Verrou, le gestionnaire de mots de passe pour Vaultwarden.",
  "version": "0.3.0",
  "key": "",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["nativeMessaging", "storage", "activeTab"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Verrou",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["generator.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
